# ==============================================================================
# Survey System Project - Environment Variable Template (.env.example)
# Copy this file to .env.development, .env.testing, or .env.production
# and configure the values according to the target environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# Container & Deployment Configuration
# ------------------------------------------------------------------------------
# Docker image repository and tag
IMAGE_NAME=survey-system-api
IMAGE_TAG=latest

# ASP.NET Core Runtime Environment (Development | Testing | Production)
ASPNETCORE_ENVIRONMENT=Development

# Host Port Bindings
API_HTTP_PORT=8080
SQLSERVER_PORT=1433
SEQ_PORT=5341

# ------------------------------------------------------------------------------
# Database Configuration (Microsoft SQL Server 2022)
# ------------------------------------------------------------------------------
# SA Password requirements: min 8 chars, including uppercase, lowercase, numbers, and symbols
SA_PASSWORD=Your_Strong_Password123!
DB_NAME=SurveyDB
HANGFIRE_DB_NAME=SurveyBasketJobs
MSSQL_PID=Developer

# Connection Strings used inside Docker network (using 'sqlserver' service hostname)
DEFAULT_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyDB;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=true;
HANGFIRE_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyBasketJobs;User Id=sa;Password=Your_Strong_Password123!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# ------------------------------------------------------------------------------
# Security & Authentication (JWT Bearer)
# ------------------------------------------------------------------------------
# JWT Secret Key must be at least 32 characters (256 bits) for HMAC-SHA256
JWT_KEY=SuperSecretJwtSigningKeyForSurveyBasketApp2026!MustBeAtLeast32CharsLong
JWT_ISSUER=SurveyBasketApp
JWT_AUDIENCE=SurveyBasketApp users
JWT_EXPIRY_IN_MINUTES=30

# ------------------------------------------------------------------------------
# Structured Logging & Observability (Serilog & Seq)
# ------------------------------------------------------------------------------
SEQ_SERVER_URL=http://seq:5341
LOG_FILE_PATH=/app/Logs/Log-.txt

# ------------------------------------------------------------------------------
# Email Notification Settings (SMTP / Ethereal Email)
# ------------------------------------------------------------------------------
MAIL_ADDRESS=oceane.gleichner96@ethereal.email
MAIL_DISPLAY_NAME=Survey Basket
MAIL_PASSWORD=your_email_password
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587

# ------------------------------------------------------------------------------
# Rate Limiting & CORS Policies
# ------------------------------------------------------------------------------
RATE_LIMIT_PERMIT=1000
RATE_LIMIT_QUEUE=100
ALLOWED_ORIGIN=https://www.survey-basket.com
