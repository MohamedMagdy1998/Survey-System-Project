# ==============================================================================
# Survey System Project - Development Environment (.env.development)
# Tailored for local development, hot-reload, debugging, and diagnostics.
# ==============================================================================

# Container & Image Settings
IMAGE_NAME=survey-system-api
IMAGE_TAG=dev

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Development

# Host Ports
API_HTTP_PORT=8080
SQLSERVER_PORT=1433
SEQ_PORT=5341

# Database Configuration (SQL Server 2022 Developer Edition)
SA_PASSWORD=DevPassword123!
DB_NAME=SurveyDB
HANGFIRE_DB_NAME=SurveyBasketJobs
MSSQL_PID=Developer

# Internal Container Connection Strings
DEFAULT_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyDB;User Id=sa;Password=DevPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;
HANGFIRE_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyBasketJobs;User Id=sa;Password=DevPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication
JWT_KEY=DevSuperSecretJwtKeyForSurveyBasketApp2026!MustBeAtLeast32Chars
JWT_ISSUER=SurveyBasketApp
JWT_AUDIENCE=SurveyBasketApp users
JWT_EXPIRY_IN_MINUTES=60

# Logging & Observability
SEQ_SERVER_URL=http://seq:5341
LOG_FILE_PATH=/app/Logs/Log-.txt

# Email Notifications (Ethereal Email for Dev)
MAIL_ADDRESS=oceane.gleichner96@ethereal.email
MAIL_DISPLAY_NAME=Survey Basket (Dev)
MAIL_PASSWORD=dev_smtp_password
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587

# Rate Limiting & CORS
RATE_LIMIT_PERMIT=1000
RATE_LIMIT_QUEUE=100
ALLOWED_ORIGIN=https://www.survey-basket.com
