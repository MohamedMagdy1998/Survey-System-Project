# ==============================================================================
# Survey System Project - Production Environment Template (.env.production)
# Hardened settings, production secrets placeholders, and resource security.
# ==============================================================================

# Container & Image Settings
IMAGE_NAME=survey-system-api
IMAGE_TAG=latest

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Production

# Host Exposure Port (Routed via Reverse Proxy / Load Balancer)
API_HTTP_PORT=8080
SQLSERVER_PORT=1433
SEQ_PORT=5341

# Database Configuration (Production SQL Server)
# IMPORTANT: Replace placeholder with a cryptographically secure password before deploying!
SA_PASSWORD=CHANGE_ME_IN_PRODUCTION_StrongAdminPassword123!
DB_NAME=SurveyDB
HANGFIRE_DB_NAME=SurveyBasketJobs
MSSQL_PID=Standard

# Internal Production Connection Strings
DEFAULT_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyDB;User Id=sa;Password=CHANGE_ME_IN_PRODUCTION_StrongAdminPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;
HANGFIRE_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyBasketJobs;User Id=sa;Password=CHANGE_ME_IN_PRODUCTION_StrongAdminPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication
# IMPORTANT: Generate a 64+ char random hex or base64 key in production!
JWT_KEY=CHANGE_ME_IN_PRODUCTION_SuperSecretJwtSigningKeyMustBeAtLeast32Chars
JWT_ISSUER=SurveyBasketApp
JWT_AUDIENCE=SurveyBasketApp users
JWT_EXPIRY_IN_MINUTES=30

# Logging & Observability
SEQ_SERVER_URL=http://seq:5341
LOG_FILE_PATH=/app/Logs/Log-.txt

# Email Notifications (Production SMTP provider like SendGrid, Mailgun, Amazon SES)
MAIL_ADDRESS=notifications@survey-basket.com
MAIL_DISPLAY_NAME=Survey Basket Production
MAIL_PASSWORD=CHANGE_ME_IN_PRODUCTION_SMTP_PASSWORD
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587

# Rate Limiting & CORS
RATE_LIMIT_PERMIT=1000
RATE_LIMIT_QUEUE=100
ALLOWED_ORIGIN=https://www.survey-basket.com
