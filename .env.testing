# ==============================================================================
# Survey System Project - Testing Environment (.env.testing)
# Configured for automated test suites, integration tests, and CI healthchecks.
# ==============================================================================

# Container & Image Settings
IMAGE_NAME=survey-system-api
IMAGE_TAG=test

# ASP.NET Core Runtime Environment
ASPNETCORE_ENVIRONMENT=Testing

# Host Ports (Offset to prevent port collision with active dev containers)
API_HTTP_PORT=8081
SQLSERVER_PORT=1434
SEQ_PORT=5342

# Database Configuration (Isolated test databases)
SA_PASSWORD=TestPassword123!
DB_NAME=SurveyDB_Test
HANGFIRE_DB_NAME=SurveyBasketJobs_Test
MSSQL_PID=Developer

# Internal Container Connection Strings
DEFAULT_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyDB_Test;User Id=sa;Password=TestPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;
HANGFIRE_CONNECTION_STRING=Server=sqlserver,1433;Database=SurveyBasketJobs_Test;User Id=sa;Password=TestPassword123!;TrustServerCertificate=True;MultipleActiveResultSets=true;

# JWT Authentication
JWT_KEY=TestSuperSecretJwtKeyForSurveyBasketApp2026!MustBeAtLeast32Chars
JWT_ISSUER=SurveyBasketApp
JWT_AUDIENCE=SurveyBasketApp users
JWT_EXPIRY_IN_MINUTES=15

# Logging & Observability
SEQ_SERVER_URL=http://seq:5341
LOG_FILE_PATH=/app/Logs/Log-.txt

# Email Notifications (Mock/Testing SMTP)
MAIL_ADDRESS=test.runner@ethereal.email
MAIL_DISPLAY_NAME=Survey Basket (Test)
MAIL_PASSWORD=test_smtp_password
MAIL_HOST=smtp.ethereal.email
MAIL_PORT=587

# Rate Limiting & CORS
RATE_LIMIT_PERMIT=10000
RATE_LIMIT_QUEUE=500
ALLOWED_ORIGIN=*
